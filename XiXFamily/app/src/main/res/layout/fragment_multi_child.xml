<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D0D2B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="// DEVICES"
            android:textColor="#FF404060"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="3" />

        <TextView
            android:id="@+id/lastSyncText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS: AWAITING..."
            android:textColor="#FF404060"
            android:textSize="9sp"
            android:letterSpacing="1"
            android:layout_marginTop="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/kidsCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="60dp"
            android:paddingBottom="40dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ NO DEVICES ]"
                android:textColor="#FF404060"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Waiting for devices to connect..."
                android:textColor="#FF404060"
                android:textSize="12sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/familyCodeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:background="#FFFF00FF"
                android:textColor="#FF0D0D2B"
                android:text="FAMILY CODE: ------"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="2" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
