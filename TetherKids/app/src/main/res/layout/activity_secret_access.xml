<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/secretTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐 Tether Kids"
        android:textColor="#00FFF5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/secretInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#A0A0B0"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnOpenMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 BUKA TETHER KIDS"
        android:textColor="#0F0F1A"
        android:backgroundTint="#00FFF5"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnShowIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👁️ TAMPILKAN ICON LAUNCHER"
        android:textColor="#0F0F1A"
        android:backgroundTint="#FFB800"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CLOSE"
        android:textColor="#A0A0B0"
        android:backgroundTint="#1A1A2E" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textColor="#606080"
        android:textSize="11sp"
        android:gravity="center"
        android:text="Cara akses:\n• Ketuk notifikasi Tether Kids 3x dalam 2 detik\n• Dial *#*#833843#*#* dari phone app\n• Settings > Apps > Tether Kids > Open" />

</LinearLayout>
