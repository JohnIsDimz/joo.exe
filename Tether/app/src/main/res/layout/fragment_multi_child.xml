<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D0D2B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Section title: "// DEVICES" — single line, tighter letter-spacing so chars don't collide -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="// DEVICES"
            android:textColor="#FF8080AA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- Sub status: single line, also tighter spacing -->
        <TextView
            android:id="@+id/lastSyncText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS: AWAITING..."
            android:textColor="#FF8080AA"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp" />

        <!-- Dynamic cards go here -->
        <LinearLayout
            android:id="@+id/deviceCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Empty state: now properly centered & texts wrap nicely without word-break -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ NO DEVICES ]"
                android:textColor="#FF8080AA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:singleLine="true"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Waiting for devices to connect..."
                android:textColor="#FF8080AA"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:maxLines="3" />

            <TextView
                android:id="@+id/familyCodeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#FFFF00FF"
                android:textColor="#FF0D0D2B"
                android:text="FAMILY CODE: ------"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:singleLine="true"
                android:gravity="center"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
